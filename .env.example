# Generate a strong random value of at least 32 bytes.
AUTH_SECRET=

# Single-operator account email.
AUTH_EMAIL=

# PBKDF2-SHA256 value formatted as: iterations:salt:64-character-hex-hash
AUTH_PASSWORD_HASH=

# Local Stage 1 persistence and worker settings.
CATALOGBRIDGE_DB_PATH=./data/catalogbridge.db
# Adaptive stays headless unless JakMall explicitly requires verification.
CATALOGBRIDGE_BROWSER_MODE=adaptive
CATALOGBRIDGE_BROWSER_PROFILE=./data/browser-profile
CATALOGBRIDGE_EVIDENCE_PATH=./data/evidence
CATALOGBRIDGE_PAGE_TIMEOUT_MS=45000
CATALOGBRIDGE_VERIFICATION_TIMEOUT_MS=120000
CATALOGBRIDGE_WORKER_POLL_MS=1500
